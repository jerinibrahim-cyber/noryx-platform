{
  "name": "@noryx/web",
  "version": "0.1.0",
  "private": true,
  "description": "Noryx web app shell — the browser-facing entry point for Sphere and Orbis modules, built on @noryx/ui-kit.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@noryx/shared-types": "workspace:*",
    "@noryx/ui-kit": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@noryx/eslint-config": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "jest": "^29.7.0"
  }
}
