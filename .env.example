# NoryX Platform — Environment Configuration Template
# Copy this file to .env for local development with Docker Compose.
# Real values in staging/production come from the managed secrets vault (Readiness Review §7.4)
# — NEVER from a committed file.

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=noryx
POSTGRES_PASSWORD=replace-with-secure-postgres-password
POSTGRES_DB=noryx

# -----------------------------------------------------------------------------
# Application Role (Least-Privilege Role created by packages/db-core/src/apply-app-role.ts)
# -----------------------------------------------------------------------------
APP_ROLE_PASSWORD=replace-with-secure-app-role-password

# -----------------------------------------------------------------------------
# Service Connection Strings (defaults to containerized postgres)
# -----------------------------------------------------------------------------
# IDENTITY_DATABASE_URL=postgresql://noryx_app:replace-with-secure-app-role-password@localhost:5432/noryx
# FINANCE_DATABASE_URL=postgresql://noryx_app:replace-with-secure-app-role-password@localhost:5432/noryx

# -----------------------------------------------------------------------------
# Authentication & Encryption Secrets
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-real-secret-in-every-environment

# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=replace-with-a-real-32-byte-hex-key
