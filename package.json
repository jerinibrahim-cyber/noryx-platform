{
  "name": "noryx-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Noryx Platform monorepo — Sphere (ERP/CRM/HRMS) + Orbis (CAFM/FM Intelligence) on a shared multi-tenant services layer.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter @noryx/db-core run migrate",
    "db:generate": "pnpm --filter @noryx/db-core run generate",
    "db:apply-app-role": "pnpm --filter @noryx/db-core run apply-app-role",
    "db:apply-db-constraints": "pnpm --filter @noryx/db-core run apply-db-constraints",
    "db:assert-role-privileges": "pnpm --filter @noryx/db-core run assert-role-privileges",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "eslint": "^9.13.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
