{
  "name": "@noryx/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Noryx design system — shared design tokens, runtime tenant theming, and base React components used across Sphere and Orbis web apps (and, unmodified, by the future React Native mobile app).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.cjs",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@noryx/eslint-config": "workspace:*",
    "typescript": "^5.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.14.0",
    "@types/jest": "^29.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "identity-obj-proxy": "^3.0.0"
  }
}
