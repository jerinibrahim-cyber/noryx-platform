{
  "name": "@noryx/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "The only internet-facing door into Noryx (System Architecture v1 §4.1). Routes by module manifest — adding a new Sphere/Orbis module means shipping a noryx.module.json, never editing this service (Pre-Development Readiness Review §6 'plug-and-play' requirement).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.config.js"
  },
  "dependencies": {
    "@noryx/auth-core": "workspace:*",
    "@noryx/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/throttler": "^6.2.0",
    "@nestjs/config": "^3.3.0",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@noryx/eslint-config": "workspace:*",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node-dev": "^2.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
