PORT=3000

# Must match every downstream service's JWT_ACCESS_SECRET exactly — the
# gateway verifies the same tokens Identity issues.
JWT_ACCESS_SECRET=replace-with-a-real-secret-in-every-environment

# Directory of noryx.module.json files, one per deployed service — see
# services/api-gateway/modules/README.md.
NORYX_MODULES_MANIFEST_DIR=./modules
