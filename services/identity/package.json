{
  "name": "@noryx/identity",
  "version": "0.1.0",
  "private": true,
  "description": "Identity & Access service — OAuth2/OIDC-shaped auth, MFA, tenant-aware JWTs (System Architecture v1 §3.2, §7). Every other service trusts tokens this service issues rather than re-implementing auth.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.config.js"
  },
  "dependencies": {
    "@noryx/auth-core": "workspace:*",
    "@noryx/db-core": "workspace:*",
    "@noryx/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/throttler": "^6.2.0",
    "@nestjs/config": "^3.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "argon2": "^0.41.1",
    "otplib": "^12.0.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@noryx/eslint-config": "workspace:*",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node-dev": "^2.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
