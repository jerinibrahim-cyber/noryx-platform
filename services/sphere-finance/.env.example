# Copy to .env for local dev. Real values in staging/production come from
# the managed secrets vault (Readiness Review §7.4) — never from a
# committed file.

PORT=3010
DATABASE_URL=postgresql://noryx:noryx@localhost:5432/noryx

# Must match Identity's JWT_ACCESS_SECRET — this service verifies tokens
# Identity issues, it does not issue its own.
# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-real-secret-in-every-environment
